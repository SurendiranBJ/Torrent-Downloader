NODE_ENV=development

PORT=4000
API_PORT=4000
WEB_PORT=3000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/torrent_db?schema=public

# Redis for BullMQ & Caching
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-replace-in-production-min-32-chars

# Transmission Engine Settings
TRANSMISSION_HOST=localhost
TRANSMISSION_RPC_PORT=9091
TRANSMISSION_RPC_USER=
TRANSMISSION_RPC_PASSWORD=

TRANSMISSION_PEER_PORT=51413

TRANSMISSION_DOWNLOAD_LIMIT=0
TRANSMISSION_UPLOAD_LIMIT=0

TRANSMISSION_GLOBAL_PEER_LIMIT=500
TRANSMISSION_PEER_LIMIT_PER_TORRENT=100

TRANSMISSION_DHT_ENABLED=true
TRANSMISSION_PEX_ENABLED=true
TRANSMISSION_LPD_ENABLED=true
TRANSMISSION_UTP_ENABLED=true

TRANSMISSION_PORT_FORWARDING_ENABLED=true

TRANSMISSION_CACHE_SIZE_MB=64

DOWNLOAD_DIR=./data/transmission/downloads
INCOMPLETE_DIR=./data/transmission/incomplete

# ================================================================
# STORAGE CONFIGURATION (AWS S3 vs MinIO)
# ================================================================

# Set to "s3" for AWS S3, or "minio" for local container
STORAGE_PROVIDER=s3

# --- Option A: AWS S3 Production Setup ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=my-torrent-downloader-bucket
# S3 Storage Classes: STANDARD, INTELLIGENT_TIERING, STANDARD_IA, GLACIER_IR
AWS_S3_STORAGE_CLASS=INTELLIGENT_TIERING

# --- Option B: Local MinIO (leave blank if using AWS S3) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

STORAGE_UPLOAD_CONCURRENCY=1
STORAGE_UPLOAD_BANDWIDTH_LIMIT=0

PERFORMANCE_LOG_INTERVAL_SECONDS=5
