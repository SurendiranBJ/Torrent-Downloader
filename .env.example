NODE_ENV=production

# Public application port (Direct Port 80, No Nginx)
PORT=80

# PostgreSQL Database (Internal to Docker network)
POSTGRES_PASSWORD=generate_a_secure_postgres_password
DATABASE_URL=postgresql://postgres:generate_a_secure_postgres_password@postgres:5432/torrent_db?schema=public

# Redis URL (Internal to Docker network)
REDIS_URL=redis://redis:6379

# ================================================================
# AUTHENTICATION SECRETS
# Generate strong 32+ character random keys for production:
# e.g., openssl rand -hex 32
# ================================================================
JWT_SECRET=YOUR_32_CHAR_MINIMUM_RANDOM_SECRET_KEY
JWT_REFRESH_SECRET=YOUR_32_CHAR_MINIMUM_RANDOM_REFRESH_KEY

# Transmission Engine Settings
TRANSMISSION_HOST=transmission
TRANSMISSION_RPC_PORT=9091
TRANSMISSION_RPC_USER=
TRANSMISSION_RPC_PASSWORD=

# Transmission BitTorrent Peer Port (Exposed publicly via Security Group)
TRANSMISSION_PEER_PORT=51413

# Bandwidth Limits (0 = Unlimited swarm throughput)
TRANSMISSION_DOWNLOAD_LIMIT=0
TRANSMISSION_UPLOAD_LIMIT=0

# Swarm Peer Limits
TRANSMISSION_GLOBAL_PEER_LIMIT=500
TRANSMISSION_PEER_LIMIT_PER_TORRENT=100

# Swarm Discovery Protocols
TRANSMISSION_DHT_ENABLED=true
TRANSMISSION_PEX_ENABLED=true
TRANSMISSION_LPD_ENABLED=true
TRANSMISSION_UTP_ENABLED=true
TRANSMISSION_PORT_FORWARDING_ENABLED=true
TRANSMISSION_CACHE_SIZE_MB=64

# EBS-backed Storage Directories
DOWNLOAD_DIR=/downloads
INCOMPLETE_DIR=/incomplete

# ================================================================
# AMAZON S3 CONFIGURATION (EC2 IAM ROLE MODE)
# On AWS EC2 with an attached IAM Role, do NOT provide access keys!
# The AWS SDK will automatically authenticate via the IAM Instance Profile.
# ================================================================
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
S3_BUCKET=your-unique-s3-bucket-name
S3_PREFIX=users/
AWS_S3_STORAGE_CLASS=INTELLIGENT_TIERING

# BullMQ Worker Concurrency & Rate Limiting
STORAGE_UPLOAD_CONCURRENCY=1
STORAGE_UPLOAD_BANDWIDTH_LIMIT=0

# Structured Performance Metrics Logging Interval
PERFORMANCE_LOG_INTERVAL_SECONDS=5
